# OpenAI API Key (required for spec normalization and reasoning)
OPENAI_API_KEY=sk-...

# ElevenLabs API Key (optional - for voice narration)
ELEVENLABS_API_KEY=...

# Fireworks AI API Key (optional - for diagram generation)
FIREWORKS_API_KEY=...

# Vibe Kanban Configuration (optional)
VIBE_KANBAN_BASE_URL=https://vibe-kanban.example/api
VIBE_KANBAN_TOKEN=...

# Convex Configuration (required)
CONVEX_DEPLOYMENT=dev
CONVEX_URL=https://your-deployment.convex.cloud

# PDD Configuration
PDD_PATH=.
PDD_BUDGET=10.00
PDD_MAX_ATTEMPTS=3
PDD_TARGET_COVERAGE=80
